{
  "name": "posters-galore-automation",
  "version": "1.0.0",
  "description": "Playwright BDD automation for Posters Galore (1-1-1 feature/page/step/scenario)",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:headed": "bddgen && playwright test --headed",
    "report": "node automation/user-flows/scripts/reporting/generate-cucumber-report.js",
    "install:browsers": "playwright install chromium"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "cross-env": "^10.1.0",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^16.4.7",
    "playwright-bdd": "^9.1.0"
  }
}
